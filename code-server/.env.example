# Environment variables for code-server Docker container
# Copy this file to .env and fill in your values

# Claude CLI API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Supabase credentials for prompt logging
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# User identification (set dynamically per session in production)
# For local dev, use a test candidate UUID from your candidates table
CANDIDATE_ID=your-candidate-uuid-here
