# Assessment Access Codes
# Comma-separated list of valid access codes (no spaces around commas recommended)
# Codes will be automatically converted to uppercase during validation
ASSESSMENT_ACCESS_CODES=HERMES-2026-BETA,ASSESS-EARLY-ACCESS,INVITE-TECH-EVAL

# Example for production:
# ASSESSMENT_ACCESS_CODES=PROD-CODE-1,PROD-CODE-2,PARTNER-XYZ-2026

# LinkedIn Import via PhantomBuster (Optional)
# Get your API key from: https://phantombuster.com/
# Only needed if you want to enable the "Quick Import" method
# If not set, only CSV upload will be available
PHANTOMBUSTER_API_KEY=your_phantombuster_api_key_here
