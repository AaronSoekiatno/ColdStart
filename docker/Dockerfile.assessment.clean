# Dockerfile.assessment.clean
# Clean VS Code Server without Copilot - Using OpenVSCode Server
# This is a completely open-source VS Code Server without any proprietary extensions

FROM gitpod/openvscode-server:latest

# Switch to root for system installations
USER root

# Disable telemetry and extensions
ENV VSCODE_DISABLE_EXTENSIONS=true
ENV VSCODE_PROXY_URI=""
ENV TELEMETRY_LEVEL=off

# Layer 1: System dependencies + Node.js (rarely changes)
RUN apt-get update && \
    apt-get install -y curl git jq procps ca-certificates sudo && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create coder user (openvscode uses 'openvscode-server' user by default, we'll create 'coder' for compatibility)
RUN useradd -m -s /bin/bash coder && \
    echo "coder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Layer 2: Install test dependencies in the assessment directory
RUN mkdir -p /usr/local/share/assessment && \
    cd /usr/local/share/assessment && \
    npm init -y && \
    npm install --save \
    vitest@^1.3.0 \
    @vitejs/plugin-react-swc@^3.11.0 \
    @testing-library/react@^14.2.0 \
    @testing-library/jest-dom@^6.4.0 \
    @testing-library/user-event@^14.5.2 \
    happy-dom@^12.10.3 \
    @typescript-eslint/parser@^8.52.0 \
    @typescript-eslint/typescript-estree@^8.52.0 \
    glob@^13.0.0 && \
    npm cache clean --force

# Layer 3: Create directories
RUN mkdir -p /workspace && chown -R coder:coder /workspace

# Layer 4: Install workspace dependencies BEFORE copying source code
COPY --chown=coder:coder workspace/package.json workspace/package-lock.json* /workspace/
RUN cd /workspace && \
    npm install --legacy-peer-deps && \
    npm cache clean --force

# Layer 5: Copy workspace source code
COPY --chown=coder:coder workspace /workspace/

# Layer 6: Link test dependencies from assessment to workspace
RUN cd /workspace && \
    TEST_PACKAGES="vitest @vitejs/plugin-react-swc @testing-library/react @testing-library/jest-dom @testing-library/user-event happy-dom @typescript-eslint/parser @typescript-eslint/typescript-estree glob" && \
    for pkg in $TEST_PACKAGES; do \
    if echo "$pkg" | grep -q "^@"; then \
    scope=$(echo "$pkg" | cut -d'/' -f1) && \
    mkdir -p "node_modules/$scope" && \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    else \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    fi; \
    done

# Layer 7: Copy scripts and configuration
COPY --chown=coder:coder scripts/entrypoint-openvscode.sh /usr/local/bin/entrypoint.sh
COPY --chown=coder:coder scripts/run-tests.sh /usr/local/bin/
COPY --chown=coder:coder scripts/log-prompt.sh /usr/local/bin/

# Secure Assessment Tests & Config
RUN mkdir -p /usr/local/share/assessment
COPY --chown=coder:coder tests /usr/local/share/assessment/tests/
COPY --chown=coder:coder config/vitest.assessment.ts /usr/local/share/assessment/vitest.config.ts

RUN chmod +x /usr/local/bin/*.sh

# Layer 8: Configure VS Code settings
RUN mkdir -p /home/coder/.openvscode-server/data/Machine
COPY --chown=coder:coder config/settings.json /home/coder/.openvscode-server/data/Machine/settings.json

# Create custom CSS to hide any chat UI (just in case)
RUN mkdir -p /home/coder/.openvscode-server/
COPY --chown=coder:coder config/custom.css /home/coder/.openvscode-server/custom.css

# Create build version file
RUN echo "{\"built_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"version\": \"$(date +%s)\", \"base\": \"openvscode-server\"}" > /home/coder/.hermes-version.json

# NUCLEAR: Remove any extensions that might exist
RUN rm -rf /home/coder/.openvscode-server/extensions/* 2>/dev/null || true && \
    rm -rf /home/openvscode-server/.openvscode-server/extensions/* 2>/dev/null || true && \
    mkdir -p /home/coder/.openvscode-server/extensions && \
    chown -R coder:coder /home/coder

# Make extensions directory read-only
RUN chmod 555 /home/coder/.openvscode-server/extensions

# Switch back to coder user
USER coder

# Environment Configuration
ENV WORKSPACE_DIR=/workspace
ENV TELEMETRY_URL=""
ENV CANDIDATE_ID=""
ENV SESSION_ID=""

EXPOSE 8080

# Use a simple entrypoint that starts openvscode-server
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
