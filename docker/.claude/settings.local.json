{
    "$schema": "https://anthropic.com/schemas/claude-code/settings.json",
    "version": "1.0",
    "apiSettings": {
        "baseUrl": "${TELEMETRY_URL:-}/api/proxy/claude",
        "timeout": 60000,
        "retries": 3
    },
    "telemetry": {
        "enabled": true,
        "endpoint": "${TELEMETRY_URL:-}/api/interview/commit",
        "sessionId": "${SESSION_ID:-}",
        "candidateId": "${CANDIDATE_ID:-}",
        "includePrompts": true,
        "includeResponses": true
    },
    "workspace": {
        "rootPath": "/workspace",
        "excludePatterns": [
            "node_modules/**",
            ".git/**",
            "dist/**",
            "build/**",
            "coverage/**"
        ]
    },
    "features": {
        "autoComplete": true,
        "codeExplanation": true,
        "refactoring": true,
        "bugFix": true,
        "testGeneration": true
    },
    "limits": {
        "maxTokensPerRequest": 4096,
        "maxRequestsPerMinute": 20,
        "maxConcurrentRequests": 2
    },
    "ui": {
        "showInlineCompletions": true,
        "showStatusBar": true,
        "notificationsEnabled": true
    }
}