# Hermes Assessment Docker Environment Configuration
# Copy this to .env and fill in the values

# Required: Unique candidate identifier (UUID)
CANDIDATE_ID=

# Required: Interview session ID for telemetry
SESSION_ID=

# Required: Hermes API base URL (your production domain)
TELEMETRY_URL=https://your-hermes-instance.com

# Required: Anthropic API key for Claude Code (passed to proxy)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required: Password to access code-server
ASSESSMENT_PASSWORD=secure-random-password

# Optional: Auto-commit interval in seconds (default: 120)
AUTO_COMMIT_INTERVAL=120

# Optional: Git configuration
GIT_USER_NAME=Candidate
GIT_USER_EMAIL=candidate@assessment.local

# Optional: Port to expose (default: 8080)
PORT=8080
