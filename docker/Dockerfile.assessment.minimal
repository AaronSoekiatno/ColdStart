# Dockerfile.assessment.minimal
# Minimal VS Code Server built from scratch - GUARANTEED NO COPILOT
# Uses official code-server install script on clean Ubuntu base

FROM ubuntu:22.04

USER root

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Layer 1: Install system dependencies and Node.js
RUN apt-get update && \
    apt-get install -y \
    curl \
    wget \
    git \
    jq \
    procps \
    ca-certificates \
    sudo \
    build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Layer 2: Install code-server using official install script
# This gives us a clean installation without pre-installed extensions
RUN curl -fsSL https://code-server.dev/install.sh | sh

# Layer 3: Create coder user
RUN useradd -m -s /bin/bash coder && \
    echo "coder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /home/coder/.local/share/code-server/User && \
    chown -R coder:coder /home/coder

# Layer 4: Install test dependencies
RUN mkdir -p /usr/local/share/assessment && \
    cd /usr/local/share/assessment && \
    npm init -y && \
    npm install --save \
    vitest@^1.3.0 \
    @vitejs/plugin-react-swc@^3.11.0 \
    @testing-library/react@^14.2.0 \
    @testing-library/jest-dom@^6.4.0 \
    @testing-library/user-event@^14.5.2 \
    happy-dom@^12.10.3 \
    @typescript-eslint/parser@^8.52.0 \
    @typescript-eslint/typescript-estree@^8.52.0 \
    glob@^13.0.0 && \
    npm cache clean --force

# Layer 5: Create workspace directory
RUN mkdir -p /workspace && chown -R coder:coder /workspace

# Layer 6: Install workspace dependencies
COPY --chown=coder:coder workspace/package.json workspace/package-lock.json* /workspace/
RUN cd /workspace && \
    npm install --legacy-peer-deps && \
    npm cache clean --force

# Layer 7: Copy workspace source
COPY --chown=coder:coder workspace /workspace/

# Layer 8: Link test dependencies
RUN cd /workspace && \
    TEST_PACKAGES="vitest @vitejs/plugin-react-swc @testing-library/react @testing-library/jest-dom @testing-library/user-event happy-dom @typescript-eslint/parser @typescript-eslint/typescript-estree glob" && \
    for pkg in $TEST_PACKAGES; do \
    if echo "$pkg" | grep -q "^@"; then \
    scope=$(echo "$pkg" | cut -d'/' -f1) && \
    mkdir -p "node_modules/$scope" && \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    else \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    fi; \
    done

# Layer 9: Copy scripts
COPY --chown=coder:coder scripts/entrypoint.sh /usr/local/bin/
COPY --chown=coder:coder scripts/run-tests.sh /usr/local/bin/
COPY --chown=coder:coder scripts/log-prompt.sh /usr/local/bin/

# Copy tests and config
RUN mkdir -p /usr/local/share/assessment
COPY --chown=coder:coder tests /usr/local/share/assessment/tests/
COPY --chown=coder:coder config/vitest.assessment.ts /usr/local/share/assessment/vitest.config.ts

RUN chmod +x /usr/local/bin/*.sh

# Layer 10: Configure code-server with STRICT anti-Copilot settings
RUN mkdir -p /home/coder/.local/share/code-server/User && \
    mkdir -p /home/coder/.config/code-server

# Create a completely locked-down settings.json
COPY --chown=coder:coder config/settings.json /home/coder/.local/share/code-server/User/settings.json

# Create code-server config
RUN cat > /home/coder/.config/code-server/config.yaml << 'EOF'
bind-addr: 0.0.0.0:8080
auth: none
cert: false
disable-telemetry: true
disable-update-check: true
EOF

# Create custom CSS
COPY --chown=coder:coder config/custom.css /home/coder/.local/share/code-server/custom.css

# Build version
RUN echo "{\"built_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"version\": \"$(date +%s)\", \"base\": \"ubuntu-minimal\"}" > /home/coder/.hermes-version.json

# CRITICAL: Pre-create extensions directory as EMPTY and READ-ONLY
# This prevents ANY extensions from being installed
RUN mkdir -p /home/coder/.local/share/code-server/extensions && \
    echo "[]" > /home/coder/.local/share/code-server/extensions/extensions.json && \
    chown -R coder:coder /home/coder && \
    chmod 555 /home/coder/.local/share/code-server/extensions

# Modify code-server's product.json to disable extensions gallery
RUN PRODUCT_JSON=$(find /usr/lib/code-server -name "product.json" 2>/dev/null | head -1) && \
    if [ -f "$PRODUCT_JSON" ]; then \
    jq 'del(.extensionsGallery) | del(.aiConfig) | .chatEnabled = false | .enableTelemetry = false' "$PRODUCT_JSON" > "$PRODUCT_JSON.tmp" && \
    mv "$PRODUCT_JSON.tmp" "$PRODUCT_JSON"; \
    fi

# Switch to coder user
USER coder

# Environment
ENV WORKSPACE_DIR=/workspace
ENV TELEMETRY_URL=""
ENV CANDIDATE_ID=""
ENV SESSION_ID=""
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
