# Dockerfile.assessment
# Containerized IDE Environment for Minerva Assessment
# Optimized for fast builds and minimal startup time

FROM codercom/code-server:latest

# Switch to root for system installations
USER root

# Disable VS Code extensions and heavy features
ENV VSCODE_DISABLE_EXTENSIONS=true
ENV VSCODE_PROXY_URI=""

# Layer 1: System dependencies + Node.js (rarely changes)
# Combined into single layer to reduce layer count and improve caching
RUN apt-get update && \
    apt-get install -y curl git jq procps ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Layer 1.5: NUCLEAR OPTION - Permanently disable chat/Copilot at build time
# This modifies code-server's product.json to disable chat features before the container even starts
RUN PRODUCT_JSON=$(find /usr/lib/code-server -name "product.json" 2>/dev/null | head -n 1) && \
    if [ -f "$PRODUCT_JSON" ]; then \
    echo "☢️  Disabling chat in product.json..." && \
    jq 'del(.extensionsGallery) | del(.aiConfig) | .chatEnabled = false | .inlineChat.enabled = false' "$PRODUCT_JSON" > "$PRODUCT_JSON.tmp" && \
    mv "$PRODUCT_JSON.tmp" "$PRODUCT_JSON" && \
    echo "✓ Chat disabled in product.json"; \
    fi && \
    echo "☢️  Removing Copilot and chat extensions..." && \
    find /usr/lib/code-server -type d -iname "*copilot*" -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/lib/code-server -type d -iname "*chat*" -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/lib/code-server -type d -iname "*github.copilot*" -exec rm -rf {} + 2>/dev/null || true && \
    echo "✓ Extensions removed"

# Layer 2: Install test dependencies in the assessment directory (rarely changes)
# These are needed for assessment tests regardless of workspace package.json
# Tests are located in /usr/local/share/assessment/tests/, so node_modules needs to be
# in /usr/local/share/assessment/node_modules for proper module resolution
RUN mkdir -p /usr/local/share/assessment && \
    cd /usr/local/share/assessment && \
    npm init -y && \
    npm install --save \
    vitest@^1.3.0 \
    @vitejs/plugin-react-swc@^3.11.0 \
    @testing-library/react@^14.2.0 \
    @testing-library/jest-dom@^6.4.0 \
    @testing-library/user-event@^14.5.2 \
    happy-dom@^12.10.3 \
    @typescript-eslint/parser@^8.52.0 \
    @typescript-eslint/typescript-estree@^8.52.0 \
    glob@^13.0.0 && \
    npm cache clean --force

# Layer 3: Create directories (rarely changes)
RUN mkdir -p /workspace && chown coder:coder /workspace

# Layer 4: Install workspace dependencies BEFORE copying source code
# This layer is cached unless package.json changes
COPY --chown=coder:coder workspace/package.json workspace/package-lock.json* /workspace/
RUN cd /workspace && \
    npm install --legacy-peer-deps && \
    npm cache clean --force

# Layer 5: Copy workspace source code (changes frequently)
# This layer rebuilds when code changes, but npm install is cached
COPY --chown=coder:coder workspace /workspace/

# Layer 6: Link test dependencies from assessment to workspace
# This runs at build time instead of startup time (saves ~1-2s per container start)
RUN cd /workspace && \
    # List of test packages to symlink from assessment node_modules \
    TEST_PACKAGES="vitest @vitejs/plugin-react-swc @testing-library/react @testing-library/jest-dom @testing-library/user-event happy-dom @typescript-eslint/parser @typescript-eslint/typescript-estree glob" && \
    for pkg in $TEST_PACKAGES; do \
    # Handle scoped packages (e.g., @vitejs/plugin-react-swc) \
    if echo "$pkg" | grep -q "^@"; then \
    scope=$(echo "$pkg" | cut -d'/' -f1) && \
    mkdir -p "node_modules/$scope" && \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    else \
    # Non-scoped package \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    fi; \
    done


# Layer 7: Copy scripts and configuration (changes occasionally)
COPY --chown=coder:coder scripts/entrypoint.sh /usr/local/bin/
COPY --chown=coder:coder scripts/run-tests.sh /usr/local/bin/
COPY --chown=coder:coder scripts/log-prompt.sh /usr/local/bin/

# Secure Assessment Tests & Config
RUN mkdir -p /usr/local/share/assessment
COPY --chown=coder:coder tests /usr/local/share/assessment/tests/
COPY --chown=coder:coder config/vitest.assessment.ts /usr/local/share/assessment/vitest.config.ts

RUN chmod +x /usr/local/bin/*.sh

# Layer 8: Configure code-server settings (rarely changes)
RUN mkdir -p /home/coder/.local/share/code-server/User
COPY --chown=coder:coder config/settings.json /home/coder/.local/share/code-server/User/
COPY --chown=coder:coder config/settings.json /home/coder/.local/share/code-server/User/settings.json.bak

# Inject custom CSS to hide Copilot/Chat UI
COPY --chown=coder:coder config/custom.css /home/coder/.local/share/code-server/

# Create build version file for verification
RUN echo "{\"built_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"version\": \"$(date +%s)\"}" > /home/coder/.hermes-version.json

RUN chown -R coder:coder /home/coder

# Switch back to coder user
USER coder

# Remove ALL extensions and chat UI components (must run as coder user)
RUN rm -rf /home/coder/.local/share/code-server/extensions/* \
    && rm -rf /home/coder/.vscode-server/extensions/* \
    && rm -rf /home/coder/.local/share/code-server/CachedExtensions* \
    && rm -rf /home/coder/.local/share/code-server/CachedExtensionVSIXs*

# ============================================
# Environment Configuration
# ============================================
# CANDIDATE_ID: Unique candidate identifier for telemetry
# SESSION_ID: Interview session ID for tracking
# TELEMETRY_URL: Hermes API base URL for telemetry reporting
# ============================================
ENV WORKSPACE_DIR=/workspace
ENV TELEMETRY_URL=""
ENV CANDIDATE_ID=""
ENV SESSION_ID=""

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
