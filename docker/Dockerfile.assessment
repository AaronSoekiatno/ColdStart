# Dockerfile.assessment
# Containerized IDE Environment for Minerva Assessment
# Day 1-2 Deliverable: Working code-server instance with Claude Code

FROM codercom/code-server:latest

# Switch to root for system installations
USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    python3-pip \
    jq \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# ============================================
# 1. Install Claude Code CLI
# ============================================
RUN npm install -g @anthropic-ai/claude-code && \
    # Create a wrapper for 'claude' that uses 'claude' but can be intercepted
    # Locate the binary (it's usually linked in /usr/local/bin or /usr/bin)
    CLAUDE_BIN=$(which claude) && \
    mv "$CLAUDE_BIN" "${CLAUDE_BIN}-real" && \
    printf '#!/bin/bash\nSCRIPT_DIR="$(dirname "$0")"\n\n# If headless flag detected, use our wrapper at ~/.local/bin/claude-code\nif [[ "$*" == *"-p"* ]] || [ $# -gt 0 ]; then\n    if [ -f "/home/coder/.local/bin/claude-code" ]; then\n        exec /home/coder/.local/bin/claude-code "$@"\n    fi\nfi\n\n# Interactive mode: just run real binary (hooks will capture prompts)\nexec "${SCRIPT_DIR}/claude-real" "$@"\n' > "$CLAUDE_BIN" && \
    chmod +x "$CLAUDE_BIN"

# ============================================
# 2. Pre-configure Claude Code settings directory
# ============================================
RUN mkdir -p /home/coder/.claude && \
    chown -R coder:coder /home/coder/.claude

# Create workspace directory
RUN mkdir -p /workspace && chown coder:coder /workspace

# Copy workspace package.json and pre-install dependencies
# Copy workspace source code and install dependencies
COPY --chown=coder:coder workspace /workspace/
RUN cd /workspace && npm install --legacy-peer-deps

# Pre-build Next.js to eliminate cold start compilation
# This creates the .next directory with pre-compiled code
RUN cd /workspace && npm run build

# Copy configuration scripts
COPY --chown=coder:coder scripts/entrypoint.sh /usr/local/bin/
COPY --chown=coder:coder scripts/telemetry-sidecar.sh /usr/local/bin/
COPY --chown=coder:coder scripts/run-tests.sh /usr/local/bin/
COPY --chown=coder:coder scripts/log-prompt.sh /usr/local/bin/

RUN chmod +x /usr/local/bin/*.sh

# Configure code-server VS Code settings (auto-save, etc.)
RUN mkdir -p /home/coder/.local/share/code-server/User
COPY --chown=coder:coder config/settings.json /home/coder/.local/share/code-server/User/

# Create build version file for verification
RUN echo "{\"built_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"version\": \"$(date +%s)\"}" > /home/coder/.hermes-version.json

RUN chown -R coder:coder /home/coder

# Uninstall GitHub Copilot extensions if present
RUN code-server --uninstall-extension GitHub.copilot 2>/dev/null || true && \
    code-server --uninstall-extension GitHub.copilot-chat 2>/dev/null || true

# Switch back to coder user
USER coder

# ============================================
# Environment Configuration
# ============================================
# CANDIDATE_ID: Unique candidate identifier for telemetry
# SESSION_ID: Interview session ID for tracking
# TELEMETRY_URL: Hermes API base URL for telemetry reporting
# ============================================
ENV WORKSPACE_DIR=/workspace
ENV TELEMETRY_URL=""
ENV CANDIDATE_ID=""
ENV SESSION_ID=""

EXPOSE 8080

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
