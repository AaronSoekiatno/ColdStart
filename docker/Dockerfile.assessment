# Dockerfile.assessment - Theia IDE Version
# Containerized IDE Environment for Minerva Assessment
# Using Theia IDE instead of code-server (no Copilot issues!)

FROM theiaide/theia:latest

# Switch to root for system installations
USER root

# Layer 1: System dependencies (rarely changes)
RUN apt-get update && \
    apt-get install -y curl git jq procps ca-certificates sudo && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create theia user if not exists and set up sudo
RUN id -u theia &>/dev/null || useradd -m -s /bin/bash theia && \
    echo "theia ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Layer 2: Install test dependencies in the assessment directory (rarely changes)
RUN mkdir -p /usr/local/share/assessment && \
    cd /usr/local/share/assessment && \
    npm init -y && \
    npm install --save \
    vitest@^1.3.0 \
    @vitejs/plugin-react-swc@^3.11.0 \
    @testing-library/react@^14.2.0 \
    @testing-library/jest-dom@^6.4.0 \
    @testing-library/user-event@^14.5.2 \
    happy-dom@^12.10.3 \
    @typescript-eslint/parser@^8.52.0 \
    @typescript-eslint/typescript-estree@^8.52.0 \
    glob@^13.0.0 && \
    npm cache clean --force

# Layer 3: Create directories (rarely changes)
RUN mkdir -p /workspace && chown theia:theia /workspace

# Layer 4: Install workspace dependencies BEFORE copying source code
COPY --chown=theia:theia workspace/package.json workspace/package-lock.json* /workspace/
RUN cd /workspace && \
    npm install --legacy-peer-deps && \
    npm cache clean --force

# Layer 5: Copy workspace source code (changes frequently)
COPY --chown=theia:theia workspace /workspace/

# Layer 6: Link test dependencies from assessment to workspace
RUN cd /workspace && \
    TEST_PACKAGES="vitest @vitejs/plugin-react-swc @testing-library/react @testing-library/jest-dom @testing-library/user-event happy-dom @typescript-eslint/parser @typescript-eslint/typescript-estree glob" && \
    for pkg in $TEST_PACKAGES; do \
    if echo "$pkg" | grep -q "^@"; then \
    scope=$(echo "$pkg" | cut -d'/' -f1) && \
    mkdir -p "node_modules/$scope" && \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    else \
    if [ -d "/usr/local/share/assessment/node_modules/$pkg" ]; then \
    ln -sf "/usr/local/share/assessment/node_modules/$pkg" "node_modules/$pkg"; \
    fi; \
    fi; \
    done

# Layer 7: Copy scripts and configuration
COPY --chown=theia:theia scripts/entrypoint.sh /usr/local/bin/
COPY --chown=theia:theia scripts/run-tests.sh /usr/local/bin/
COPY --chown=theia:theia scripts/log-prompt.sh /usr/local/bin/

# Secure Assessment Tests & Config
RUN mkdir -p /usr/local/share/assessment
COPY --chown=theia:theia tests /usr/local/share/assessment/tests/
COPY --chown=theia:theia config/vitest.assessment.ts /usr/local/share/assessment/vitest.config.ts

RUN chmod +x /usr/local/bin/*.sh

# Layer 8: Configure Theia settings
RUN mkdir -p /home/theia/.theia
COPY --chown=theia:theia config/theia-settings.json /home/theia/.theia/settings.json

# Add minimal CSS for assessment-focused UI
COPY --chown=theia:theia config/theia-minimal.css /home/theia/.theia/minimal.css

# Create build version file for verification
RUN echo "{\"built_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\", \"version\": \"$(date +%s)\", \"ide\": \"theia\"}" > /home/theia/.hermes-version.json

RUN chown -R theia:theia /home/theia

# Switch back to theia user
USER theia

# Environment Configuration
ENV WORKSPACE_DIR=/workspace
ENV TELEMETRY_URL=""
ENV CANDIDATE_ID=""
ENV SESSION_ID=""
ENV HOME=/home/theia

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
